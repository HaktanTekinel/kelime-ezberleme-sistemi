# Database Configuration
# Local SQLite için boş bırakabilirsin; backend otomatik backend/kelime_ezberleme.db oluşturur.
# PostgreSQL kullanacaksan örnek:
# DATABASE_URL=postgresql://postgres:SIFRE@localhost:5432/kelime_ezberleme
DATABASE_URL=sqlite:///./kelime_ezberleme.db

# JWT / Auth Configuration
SECRET_KEY=YOUR_SECRET_KEY_HERE_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Upload / Forgot Password Demo
UPLOAD_DIR=./uploads
EXPOSE_RESET_TOKEN_IN_RESPONSE=true

# Word Chain LLM
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
